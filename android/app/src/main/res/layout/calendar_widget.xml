<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/calendar_widget_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/cal_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bugün"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/cal_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Bugün etkinlik yok"
        android:textColor="#FFFFFFFF"
        android:alpha="0.85"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cal_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/cal_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/cal_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cal_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/cal_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/cal_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cal_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/cal_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/cal_title_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
